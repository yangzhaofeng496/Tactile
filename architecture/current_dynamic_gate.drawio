      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="TactileResidualACT：动态 Head Gate + 动态 Modality Gate（当前配置）" style="text;html=1;strokeColor=none;fillColor=none;fontSize=24;fontStyle=1;align=center" vertex="1" parent="1"><mxGeometry x="560" y="25" width="1100" height="45" as="geometry"/></mxCell>

        <mxCell id="in_force" value="当前力&#xa;[B, 12]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13" vertex="1" parent="1"><mxGeometry x="35" y="155" width="155" height="58" as="geometry"/></mxCell>
        <mxCell id="enc_force" value="CurrentForceEncoder&#xa;MLP → [B, 36]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13" vertex="1" parent="1"><mxGeometry x="235" y="145" width="205" height="78" as="geometry"/></mxCell>
        <mxCell id="in_state" value="机器人状态&#xa;[B, 6]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13" vertex="1" parent="1"><mxGeometry x="35" y="290" width="155" height="58" as="geometry"/></mxCell>
        <mxCell id="enc_state" value="StateEncoder&#xa;MLP → [B, 36]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13" vertex="1" parent="1"><mxGeometry x="235" y="280" width="205" height="78" as="geometry"/></mxCell>
        <mxCell id="in_action" value="ACT 动作块&#xa;[B, 30, 6]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13" vertex="1" parent="1"><mxGeometry x="35" y="425" width="155" height="58" as="geometry"/></mxCell>
        <mxCell id="enc_action" value="ActionEncoder&#xa;MLP → [B, 72]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13" vertex="1" parent="1"><mxGeometry x="235" y="415" width="205" height="78" as="geometry"/></mxCell>
        <mxCell id="in_visual" value="ACT 视觉 tokens&#xa;[B, S, 512]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13" vertex="1" parent="1"><mxGeometry x="35" y="560" width="155" height="58" as="geometry"/></mxCell>
        <mxCell id="enc_visual" value="VisualTokenEncoder&#xa;mean pool + Linear → [B, 72]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13" vertex="1" parent="1"><mxGeometry x="235" y="545" width="205" height="88" as="geometry"/></mxCell>

        <mxCell id="concat" value="特征拼接&#xa;[B, 36 + 36 + 72 + 72] = [B, 216]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;fontStyle=1" vertex="1" parent="1"><mxGeometry x="505" y="320" width="245" height="90" as="geometry"/></mxCell>
        <mxCell id="mod_gate" value="动态 Modality Gate&#xa;Linear(216→32) → GELU → Linear(32→4)&#xa;Softmax：当前力 / 状态 / 动作 / 视觉&#xa;每个样本一组权重" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;fontStyle=1" vertex="1" parent="1"><mxGeometry x="800" y="180" width="310" height="145" as="geometry"/></mxCell>
        <mxCell id="mod_apply" value="按模态分块加权&#xa;4 × softmax 权重（保持均值尺度）&#xa;→ [B, 216]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13" vertex="1" parent="1"><mxGeometry x="800" y="365" width="310" height="90" as="geometry"/></mxCell>
        <mxCell id="head_gate" value="动态 Head Gate&#xa;Linear(216→32) → GELU → Linear(32→4)&#xa;Softmax：每个样本 4 个 head 权重" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;fontStyle=1" vertex="1" parent="1"><mxGeometry x="800" y="495" width="310" height="120" as="geometry"/></mxCell>

        <mxCell id="heads" value="4 个并行 Fusion Head（参数独立）&#xa;每个：Linear(216→96) → GELU → LayerNorm → Dropout&#xa;加权求和 → [B, 96]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1" vertex="1" parent="1"><mxGeometry x="1180" y="285" width="350" height="150" as="geometry"/></mxCell>
        <mxCell id="residual" value="Residual Skip&#xa;Linear(216→96)&#xa;与 Head 融合结果相加 + LayerNorm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13" vertex="1" parent="1"><mxGeometry x="1180" y="485" width="350" height="105" as="geometry"/></mxCell>
        <mxCell id="ffn" value="Fusion FFN&#xa;Linear(96→80) → GELU → Dropout → Linear(80→80)&#xa;Residual + LayerNorm → [B, 80]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13" vertex="1" parent="1"><mxGeometry x="1590" y="365" width="335" height="125" as="geometry"/></mxCell>
        <mxCell id="decoder" value="ResidualDecoder&#xa;Linear(80→48) → ReLU → Linear(48→180)&#xa;Reshape → [B, 30, 6]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;fontStyle=1" vertex="1" parent="1"><mxGeometry x="1590" y="555" width="335" height="115" as="geometry"/></mxCell>
        <mxCell id="output" value="预测残差 Δpred&#xa;[B, 30, 6]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;fontStyle=1" vertex="1" parent="1"><mxGeometry x="1990" y="555" width="180" height="70" as="geometry"/></mxCell>
        <mxCell id="loss" value="与目标残差比较&#xa;Δtarget = 专家动作 − ACT 动作&#xa;Loss = MSE(Δpred, Δtarget)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1" vertex="1" parent="1"><mxGeometry x="1970" y="690" width="240" height="105" as="geometry"/></mxCell>

        <mxCell id="tactile_note" value="触觉历史分支当前关闭&#xa;tactile_encoder.enabled: false&#xa;若开启，将额外加入 VQ-VAE 输出 [B, 512]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontSize=12;fontColor=#666666" vertex="1" parent="1"><mxGeometry x="35" y="720" width="405" height="85" as="geometry"/></mxCell>

