  <diagram name="Future Self-Attention Fusion" id="self-attention-fusion">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2800" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="ResidualACT: Self-Attention Fusion 架构（未来版本）" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontStyle=1" parent="1" vertex="1"><mxGeometry x="600" y="30" width="1100" height="50" as="geometry"/></mxCell>
        <mxCell id="stage1" value="输入特征" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontStyle=1" parent="1" vertex="1"><mxGeometry x="30" y="100" width="310" height="30" as="geometry"/></mxCell>
        <mxCell id="input" value="Four encoded modalities&#xa;force [B,36] · state [B,36] · action [B,72] · visual [B,72]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13" parent="1" vertex="1"><mxGeometry x="30" y="275" width="310" height="100" as="geometry"/></mxCell>
        <mxCell id="stage2" value="模态投影与 Token 化" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontStyle=1" parent="1" vertex="1"><mxGeometry x="420" y="100" width="300" height="30" as="geometry"/></mxCell>
        <mxCell id="projection" value="Modality-specific projections&#xa;Linear → 96 dims each&#xa;+ modality embeddings" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;fontStyle=1" parent="1" vertex="1"><mxGeometry x="420" y="255" width="300" height="140" as="geometry"/></mxCell>
        <mxCell id="stage3" value="Modality Tokens" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontStyle=1" parent="1" vertex="1"><mxGeometry x="800" y="100" width="260" height="30" as="geometry"/></mxCell>
        <mxCell id="tokens" value="模态 Tokens&#xa;[force, state, action, visual]&#xa;Tensor: [B,4,96]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;fontStyle=1" parent="1" vertex="1"><mxGeometry x="800" y="275" width="260" height="100" as="geometry"/></mxCell>
        <mxCell id="stage4" value="Multi-Head Self-Attention" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontStyle=1" parent="1" vertex="1"><mxGeometry x="1130" y="100" width="380" height="30" as="geometry"/></mxCell>
        <mxCell id="attention" value="1 layer Multi-Head Self-Attention&#xa;Q,K,V projections&#xa;4 heads × 24 dims&#xa;Attention matrix: [B,4,4,4]&#xa;&#xa;每个样本动态计算 token-to-token attention" style="swimlane;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;fontStyle=1" parent="1" vertex="1"><mxGeometry x="1130" y="180" width="380" height="270" as="geometry"/></mxCell>
        <mxCell id="stage5" value="残差连接 + FFN" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontStyle=1" parent="1" vertex="1"><mxGeometry x="1580" y="100" width="280" height="30" as="geometry"/></mxCell>
        <mxCell id="norm" value="Residual + LayerNorm&#xa;FFN + Residual + LayerNorm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1" parent="1" vertex="1"><mxGeometry x="1580" y="260" width="280" height="110" as="geometry"/></mxCell>
        <mxCell id="stage6" value="Pooling 与输出" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontStyle=1" parent="1" vertex="1"><mxGeometry x="1930" y="100" width="630" height="30" as="geometry"/></mxCell>
        <mxCell id="pool" value="Mean pooling / action pooling&#xa;[B,4,96] → [B,96]&#xa;Linear → [B,80]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;fontStyle=1" parent="1" vertex="1"><mxGeometry x="1930" y="260" width="280" height="110" as="geometry"/></mxCell>
        <mxCell id="decoder" value="Existing Residual Decoder&#xa;Linear(80→48) → Linear(48→180)&#xa;Reshape → [B,30,6]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;fontStyle=1" parent="1" vertex="1"><mxGeometry x="2280" y="260" width="280" height="110" as="geometry"/></mxCell>
