        <mxCell id="weights" value="softmax(head_weights)&#xa;4 个全局 head 权重&#xa;加权叠加 → LayerNorm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontStyle=1" parent="1" vertex="1"><mxGeometry x="680" y="515" width="310" height="80" as="geometry"/></mxCell>
