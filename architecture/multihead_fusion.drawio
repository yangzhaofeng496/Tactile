        <mxCell id="head_steps" value="4 个独立 Fusion Head&#xa;Linear(216→96) + GELU&#xa;LayerNorm + Dropout&#xa;每个 head 接收相同的 [B,216]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11" parent="heads" vertex="1"><mxGeometry x="20" y="45" width="390" height="110" as="geometry"/></mxCell>
