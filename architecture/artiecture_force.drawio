                <mxCell id="mh_title" value="Current ResidualACT: Multi-Head MLP Fusion" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=24;fontStyle=1" parent="mh1" vertex="1"><mxGeometry x="650" y="30" width="900" height="50" as="geometry"/></mxCell>
                <mxCell id="mh_inputs" value="Encoded modalities&#xa;current_force [B,36]&#xa;state [B,36]&#xa;action chunk [B,72]&#xa;visual [B,72]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" parent="mh1" vertex="1"><mxGeometry x="40" y="260" width="240" height="150" as="geometry"/></mxCell>
                <mxCell id="mh_concat" value="Concat&#xa;[B, 216]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;fontStyle=1" parent="mh1" vertex="1"><mxGeometry x="360" y="290" width="180" height="80" as="geometry"/></mxCell>
                <mxCell id="mh_heads" value="4 independent MLP heads&#xa;Linear(216→96) → GELU → LayerNorm → Dropout" style="swimlane;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;fontStyle=1" parent="mh1" vertex="1"><mxGeometry x="620" y="160" width="430" height="330" as="geometry"/></mxCell>
                <mxCell id="mh_head_detail" value="Head 0 / 1 / 2 / 3&#xa;each receives the same concat vector&#xa;head output: [B,96]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" parent="mh_heads" vertex="1"><mxGeometry x="25" y="70" width="380" height="100" as="geometry"/></mxCell>
                <mxCell id="mh_head_weight" value="softmax(global head_weights)&#xa;4 scalar weights&#xa;shared across samples" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1" parent="mh_heads" vertex="1"><mxGeometry x="25" y="195" width="380" height="80" as="geometry"/></mxCell>
                <mxCell id="mh_norm" value="Weighted sum&#xa;LayerNorm → residual connection → FFN&#xa;Fusion output [B,80]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1" parent="mh1" vertex="1"><mxGeometry x="1120" y="250" width="300" height="130" as="geometry"/></mxCell>
                <mxCell id="mh_decoder" value="Residual Decoder&#xa;Linear(80→48) → ReLU&#xa;Linear(48→180)&#xa;Reshape → [B,30,6]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;fontStyle=1" parent="mh1" vertex="1"><mxGeometry x="1510" y="250" width="300" height="130" as="geometry"/></mxCell>
                <mxCell id="mh_out" value="30-step delta action&#xa;Δaction [B,30,6]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;fontStyle=1" parent="mh1" vertex="1"><mxGeometry x="1890" y="275" width="240" height="80" as="geometry"/></mxCell>
                <mxCell id="mh_e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#82b366;" edge="1" parent="mh1" source="mh_inputs" target="mh_concat"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell id="mh_e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#82b366;" edge="1" parent="mh1" source="mh_concat" target="mh_heads"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell id="mh_e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#82b366;" edge="1" parent="mh1" source="mh_heads" target="mh_norm"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell id="mh_e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#82b366;" edge="1" parent="mh1" source="mh_norm" target="mh_decoder"><mxGeometry relative="1" as="geometry"/></mxCell>
