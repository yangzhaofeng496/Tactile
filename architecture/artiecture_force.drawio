                <mxCell id="sa_attn" value="1 layer Multi-Head Self-Attention&#xa;Q,K,V projections&#xa;4 heads × 24 dims&#xa;Attention matrix: [B,4,4,4]" style="swimlane;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;fontStyle=1" parent="sa1" vertex="1"><mxGeometry x="1130" y="180" width="380" height="270" as="geometry"/></mxCell>
