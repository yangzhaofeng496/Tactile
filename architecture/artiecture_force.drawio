                <mxCell id="sa_norm" value="Residual + LayerNorm&#xa;FFN + Residual + LayerNorm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1" parent="sa1" vertex="1"><mxGeometry x="1580" y="260" width="280" height="110" as="geometry"/></mxCell>
