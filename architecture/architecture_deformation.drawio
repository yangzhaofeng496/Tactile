<mxfile host="65bd71144e">
    <diagram name="Deform Autoencoder Architecture" id="architecture">
        <mxGraphModel dx="1354" dy="967" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1200" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="input_image" value="指尖形变图 d&#xa;[B, 1, 240, 240]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;fontStyle=1" parent="1" vertex="1">
                    <mxGeometry x="960" width="220" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="encoder_box" value="DeformEncoder&#xa;基于 torchvision.models.resnet18(weights=None)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;fontStyle=1;startSize=40;" parent="1" vertex="1">
                    <mxGeometry x="320" y="150" width="480" height="470" as="geometry"/>
                </mxCell>
                <mxCell id="enc_stem" value="Stem&#xa;Conv2d(1→64, k=7, s=2, p=3)&#xa;BatchNorm2d + ReLU + MaxPool&#xa;输出: [B, 64, 60, 60]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12" parent="encoder_box" vertex="1">
                    <mxGeometry x="20" y="50" width="440" height="75" as="geometry"/>
                </mxCell>
                <mxCell id="enc_layer1" value="layer1&#xa;输出: [B, 64, 60, 60]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12" parent="encoder_box" vertex="1">
                    <mxGeometry x="20" y="140" width="440" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="enc_layer2" value="layer2&#xa;输出: [B, 128, 30, 30]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12" parent="encoder_box" vertex="1">
                    <mxGeometry x="20" y="200" width="440" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="enc_proj2" value="Conv2d(128→128, k=3, s=1, p=1)&#xa;BatchNorm2d + ReLU&#xa;输出: [B, 128, 30, 30]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12" parent="encoder_box" vertex="1">
                    <mxGeometry x="20" y="260" width="440" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="enc_layer3" value="layer3&#xa;输出: [B, 256, 15, 15]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12" parent="encoder_box" vertex="1">
                    <mxGeometry x="20" y="335" width="440" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="enc_proj3" value="Conv2d(256→128, k=3, s=1, p=1)&#xa;BatchNorm2d + ReLU&#xa;最终 z: [B, 128, 15, 15]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontStyle=1" parent="encoder_box" vertex="1">
                    <mxGeometry x="20" y="395" width="440" height="65" as="geometry"/>
                </mxCell>
                <mxCell id="decoder_box" value="DeformDecoder&#xa;仅在自编码器预训练阶段使用" style="swimlane;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;fontStyle=1;startSize=40;" parent="1" vertex="1">
                    <mxGeometry x="840" y="210" width="400" height="350" as="geometry"/>
                </mxCell>
                <mxCell id="dec_up1" value="Upsample(scale_factor=4, nearest)&#xa;[B, 128, 15, 15] → [B, 128, 60, 60]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12" parent="decoder_box" vertex="1">
                    <mxGeometry x="20" y="50" width="360" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="dec_conv1" value="Conv2d(128→64, k=5, s=1, p=2) + ReLU&#xa;输出: [B, 64, 60, 60]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12" parent="decoder_box" vertex="1">
                    <mxGeometry x="20" y="120" width="360" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="dec_up2" value="Upsample(scale_factor=4, nearest)&#xa;[B, 64, 60, 60] → [B, 64, 240, 240]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12" parent="decoder_box" vertex="1">
                    <mxGeometry x="20" y="190" width="360" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="dec_conv2" value="Conv2d(64→1, k=5, s=1, p=2)&#xa;输出激活可配置: identity / sigmoid / tanh&#xa;重建图 d_hat: [B, 1, 240, 240]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1" parent="decoder_box" vertex="1">
                    <mxGeometry x="20" y="260" width="360" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="loss_box" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" parent="1" vertex="1">
                    <mxGeometry x="1280" y="280" width="470" height="250" as="geometry"/>
                </mxCell>
                <mxCell id="loss_input" value="原始形变图 d&#xa;[B, 1, 240, 240]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12" parent="1" vertex="1">
                    <mxGeometry x="1520" y="320" width="160" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="loss_recon" value="重建形变图 d_hat&#xa;[B, 1, 240, 240]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12" parent="1" vertex="1">
                    <mxGeometry x="1330" y="320" width="160" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="loss_formula" value="Pixel Loss: MSE / L1 / Huber&#xa;可选 Edge Loss: |∇x d_hat - ∇x d|_1 + |∇y d_hat - ∇y d|_1&#xa;总损失: L = L_pixel + λ_edge L_edge&#xa;支持样本权重 w_i，强调明显接触帧但保留无接触帧" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;align=left;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="1310" y="400" width="410" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="edge_input_to_encoder" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#9673a6;exitX=0;exitY=0.5;entryX=0.5;entryY=0;entryDx=0;entryDy=0;exitDx=0;exitDy=0;" parent="1" source="input_image" target="encoder_box" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
