                <mxCell id="edge_encoder_to_decoder" value="z" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#d79b00;fontSize=12;fontStyle=1" parent="1" source="encoder_box" target="decoder_box" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
